# Paths only: keep actual credentials out of environment variables.
INSTALLER_PATH=/absolute/private/path/installer.zip
AGENT_CONFIG_PATH=/absolute/private/path/agent_config
INSTALLER_SHA256=REPLACE_WITH_ARCHIVE_SHA256
# Generate a new UUID for each host. Keep it through container recreation.
AGENT_INSTANCE_ID=REPLACE_WITH_UUID
# Explicit acknowledgement: this does not establish accurate host monitoring.
ACCEPT_EXPERIMENTAL=no
WRAPPER_IMAGE=automate-agent:local
